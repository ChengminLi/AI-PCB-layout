TEXT 16 -32 Left 2 ;INPUT: 24 V bench supply, C4 bulk, C5/C6 hot-loop ceramics
TEXT 384 -32 Left 2 ;POWER STAGE: T1 primary (Wurth 750311591), Q1 IRF520N, R4 current sense
TEXT 456 300 Left 1 ;Q1 on the board
TEXT 176 368 Left 1 ;RG jumper (Rg)
TEXT 496 368 Left 2 ;SNUB RC snubber: SNUB=1
TEXT 640 -32 Left 2 ;RCD CLAMP: D2 ES2D, C15 22n, R9||R10||R20 = 3 x 4.7k = 1.57k
TEXT 1056 -32 Left 2 ;SECONDARY: T1 secondary (Ns = Np/1.5), D3 || D7 SS510C, C20/C21 + C18/C19, load + load step
TEXT 1104 336 Left 1 ;Secondary ground (SGND) shares the simulator ground: the transformer still isolates the windings
TEXT 1648 304 Left 1 ;load step: Istep on/off
TEXT -160 512 Left 2 ;CONTROLLER U1 UC3845B (behavioural model): RT/CT = R2 5.6k / C10 1n -> 307 kHz osc., 153 kHz switching
TEXT 512 600 Left 1 ;U2 L78L12 (ideal 12 V)
TEXT 704 592 Left 2 ;U4 LTV-817S opto (CTR, FOPTO)
TEXT 1040 512 Left 2 ;FEEDBACK: U3 TL431, R15/R16 -> Vout = 2.495*(1+39k/10k) = 12.23 V, comp. R19 10k + C22 47n, R17/R18 1k
TEXT -160 1072 Left 2 ;24 V -> 12.2 V / 1 A DCM flyback, CLOSED LOOP (peak-current mode, UC3845B + TL431 + opto). 5SWB0 EMC demo board rev B.
TEXT -160 1104 Left 2 ;Load: Rload = 24.4 ohm (0.5 A) + Istep 0.5 A -> 1 A until tstep (2 ms), 0.5 A for tdur (2 ms), then 1 A again (load-step test)
TEXT -160 1136 Left 2 ;Starts from the steady state (.ic + uic) because the TL431 integrator (R15*C22) needs ~10 ms to settle from zero
TEXT -160 1168 Left 2 ;Knobs: Rg (RG), SNUB (jumper SNUB), Lpcb, Vin  |  loop: CTR (LTV-817S: 0.5...6), FOPTO opto pole, RDIV (UC3845 internal COMP load)
TEXT -160 1200 Left 2 ;Try:  .step param CTR list 0.5 1 2   or   .step param Vin list 18 24 30   (line range)   or   C12/C22/R19 values
TEXT -160 1232 Left 2 ;Models: EMC_flyback_control.lib (behavioural UC3845B, TL431, LTV-817). Keep the .lib and the three .asy files next to this .asc
TEXT -160 1264 Left 2 ;Plots: V(vout), V(comp), V(fbk), I(Lp), V(drain), V(gate). Results of .meas: View > SPICE Error Log
TEXT -160 1296 Left 2 !.include EMC_flyback_control.lib
TEXT -160 1328 Left 2 !.param Vin=24 Rload=24.4 Istep=0.5 tstep=2m tdur=2m
TEXT -160 1360 Left 2 !.param Rg=4.7 SNUB=0 Lpcb=10n
TEXT -160 1392 Left 2 !.param Lp_val=8u n=1.5
TEXT -160 1424 Left 2 !.param CTR=1 FOPTO=20k RDIV=30k
TEXT -160 1456 Left 2 !K1 Lp Ls 0.9747
TEXT -160 1488 Left 2 !.tran 0 6m 0 5n uic
TEXT -160 1520 Left 2 !.ic V(vout)=12.23 V(vbus)=24 V(clamp)=64 V(vref)=5 V(comp)=3.05 V(opta)=10.44 V(fbk)=9.4 V(fbc)=9.4 V(ref)=2.495
TEXT -160 1552 Left 2 !.model IRF520N VDMOS(Vto=3.6 Kp=6 lambda=0.03 Rd=0.11 Rs=0.025 Rg=2.5 Cgdmax=600p Cgdmin=25p a=0.5 Cgs=300p Cjo=260p M=0.55 Vj=0.8 Is=2e-12 Rb=0.02 N=1.1 Tt=60n mfg=Infineon Vds=100 Ron=200m Qg=25n)
TEXT -160 1584 Left 2 !.model ES2D D(Is=1e-9 N=1.8 Rs=0.05 Cjo=20p M=0.4 Tt=20n BV=200 Ibv=5u)
TEXT -160 1616 Left 2 !.model SS510C D(Is=5e-5 N=1.1 Rs=0.02 Cjo=300p M=0.5 BV=100 Ibv=50u)
TEXT -160 1648 Left 2 ;.step param CTR list 0.5 1 2
TEXT -160 1680 Left 2 ;Cold start (0 V output, no soft-start in the UC3845): replace the .ic line by  .ic V(vout)=0 V(vbus)=24  and run 20 ms
TEXT 1100 1296 Left 2 !.meas TRAN Vout_1A AVG V(vout) FROM 1.6m TO 2m
TEXT 1100 1328 Left 2 !.meas TRAN Vout_0A5 AVG V(vout) FROM 3.6m TO 4m
TEXT 1100 1360 Left 2 !.meas TRAN Vout_max MAX V(vout) FROM 2m TO 4m
TEXT 1100 1392 Left 2 !.meas TRAN Vout_min MIN V(vout) FROM 4m TO 6m
TEXT 1100 1424 Left 2 !.meas TRAN Vripple PP V(vout) FROM 1.9m TO 2m
TEXT 1100 1456 Left 2 !.meas TRAN Vcomp_1A AVG V(comp) FROM 1.6m TO 2m
TEXT 1100 1488 Left 2 !.meas TRAN Vds_max MAX V(drain) FROM 1.6m TO 2m
TEXT 1100 1520 Left 2 !.meas TRAN Ipri_pk MAX I(Lp) FROM 1.6m TO 2m
TEXT 1100 1552 Left 2 !.meas TRAN Pin AVG -V(vbus)*I(V1) FROM 1.6m TO 2m
TEXT 1100 1584 Left 2 !.meas TRAN Pout AVG V(vout)*(V(vout)/Rload+I(Istep)) FROM 1.6m TO 2m
TEXT 1100 1616 Left 2 !.meas TRAN Eff PARAM Pout/Pin
